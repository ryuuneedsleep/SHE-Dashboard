# ==============================================================================
# SPLD SAFETY PWA — Environment Variables Configuration
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT:
# - Never commit the .env file containing real credentials to version control.
# - For Neon PostgreSQL, use the Pooled connection string for serverless compatibility.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# Neon PostgreSQL pooled connection string
# Example: postgresql://[user]:[password]@[endpoint]-pooler.c-2.neon.tech/[dbname]?sslmode=require
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# Port for standalone Express backend server (defaults to 3001 if omitted)
API_PORT=3001

# Runtime environment ('development', 'production', or 'test')
# In 'production', internal 500 error messages are sanitized and cookies use 'Secure'
NODE_ENV=development

# ------------------------------------------------------------------------------
# 3. CORS & ORIGIN SECURITY
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for CORS and CSRF verification
# In development, standard localhost ports (5173, 3000, 3001) are allowed by default
# Example for production: https://spld-safety.vercel.app
ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 4. VERCEL BLOB PRIVATE STORAGE (Optional for local development / testing)
# ------------------------------------------------------------------------------
# Vercel Blob read/write token. Automatically injected by Vercel when deployed.
# Required locally ONLY if executing live Blob tests (npm run test:blob:live).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 5. CONCURRENCY TESTING DATABASE (Optional / Development Only)
# ------------------------------------------------------------------------------
# Dedicated isolated PostgreSQL database connection string for running
# live concurrency stress tests (npm run test:concurrency:live).
# MUST NOT point to production database (the script validates this and will abort).
# TEST_DATABASE_URL=postgresql://[user]:[password]@[endpoint]-pooler.c-2.neon.tech/test_db?sslmode=require
