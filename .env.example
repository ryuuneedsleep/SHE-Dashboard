# SPLD SAFETY - Backend Environment Variables
# Copy this file to .env and configure your credentials locally
# Note: Use the pooled connection string from Neon for serverless runtime compatibility

DATABASE_URL=
API_PORT=3001
NODE_ENV=development

# Allowed CORS & CSRF origins (comma-separated, e.g. http://localhost:5173)
# In development, standard localhost ports are allowed by default
ALLOWED_ORIGINS=
